{
  "info": {
    "title": "PunchPlay Platform API",
    "version": "1.0.0-beta.5",
    "description": "Beta contract for the Platform API and stable v1 contract for the read-only Public API. OAuth access tokens use explicit per-operation scopes."
  },
  "components": {
    "schemas": {
      "PlaybackInput": {
        "type": "object",
        "required": [
          "event_id",
          "event_created_at",
          "media_type",
          "playback_session_id",
          "title"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "media_type": {
            "type": "string",
            "enum": [
              "movie",
              "episode"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "year": {
            "type": "integer",
            "minimum": 1800,
            "maximum": 3000
          },
          "imdb_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "tmdb_id": {
            "type": "integer",
            "minimum": 1
          },
          "tvdb_id": {
            "type": "integer",
            "minimum": 1
          },
          "punchplay_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "season": {
            "type": "integer",
            "minimum": 0
          },
          "episode": {
            "type": "integer",
            "minimum": 1
          },
          "episode_end": {
            "type": "integer",
            "minimum": 1
          },
          "absolute_episode": {
            "type": "integer",
            "minimum": 1
          },
          "episode_title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "multi_episode": {
            "type": "boolean"
          },
          "anime": {
            "type": "boolean"
          },
          "progress": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Completion ratio. When position_seconds is omitted, duration_seconds is required and the API derives the resume position."
          },
          "duration_seconds": {
            "type": "number",
            "minimum": 0
          },
          "position_seconds": {
            "type": "number",
            "minimum": 0,
            "description": "Authoritative resume position. Required for pause, progress, and incomplete stop unless progress and duration_seconds are supplied."
          },
          "device_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "playback_session_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "event_created_at": {
            "type": "number",
            "minimum": 1,
            "description": "Unix timestamp in milliseconds. Events more than five minutes in the future are rejected."
          },
          "client_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "watched": {
            "type": "boolean"
          },
          "watched_threshold": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          },
          "raw_filename": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "jellyfin_user_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "additionalProperties": false
      },
      "BulkHistoryItem": {
        "type": "object",
        "required": [
          "client_item_id",
          "kind",
          "watched_at"
        ],
        "properties": {
          "client_item_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "kind": {
            "type": "string",
            "enum": [
              "movie",
              "episode"
            ]
          },
          "tmdb_id": {
            "type": "integer",
            "minimum": 1
          },
          "imdb_id": {
            "type": "string",
            "pattern": "^tt\\d+$"
          },
          "tvdb_id": {
            "type": "integer",
            "minimum": 1
          },
          "mal_id": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "year": {
            "type": "integer",
            "minimum": 1888,
            "maximum": 2100
          },
          "watched_at": {
            "type": "string",
            "format": "date-time"
          },
          "season": {
            "type": "integer",
            "minimum": 0
          },
          "episode": {
            "type": "integer",
            "minimum": 1
          },
          "episode_title": {
            "type": "string",
            "maxLength": 500
          },
          "poster_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "still_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "runtime_minutes": {
            "type": "integer",
            "minimum": 1
          }
        },
        "anyOf": [
          {
            "required": [
              "tmdb_id"
            ]
          },
          {
            "required": [
              "imdb_id"
            ]
          },
          {
            "required": [
              "tvdb_id"
            ]
          },
          {
            "required": [
              "mal_id"
            ]
          }
        ],
        "additionalProperties": false
      },
      "BulkHistoryInput": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/BulkHistoryItem"
            }
          }
        },
        "additionalProperties": false
      },
      "BulkWatchlistItem": {
        "type": "object",
        "required": [
          "kind"
        ],
        "properties": {
          "client_item_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "kind": {
            "type": "string",
            "enum": [
              "movie",
              "show"
            ]
          },
          "tmdb_id": {
            "type": "integer",
            "minimum": 1
          },
          "imdb_id": {
            "type": "string",
            "pattern": "^tt\\d+$"
          },
          "tvdb_id": {
            "type": "integer",
            "minimum": 1
          },
          "mal_id": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "poster_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "is_anime": {
            "type": "boolean"
          },
          "remove": {
            "type": "boolean"
          }
        },
        "anyOf": [
          {
            "required": [
              "tmdb_id"
            ]
          },
          {
            "required": [
              "imdb_id",
              "client_item_id"
            ]
          },
          {
            "required": [
              "tvdb_id",
              "client_item_id"
            ]
          },
          {
            "required": [
              "mal_id",
              "client_item_id"
            ]
          }
        ],
        "additionalProperties": false
      },
      "BulkWatchlistInput": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/BulkWatchlistItem"
            }
          }
        },
        "additionalProperties": false
      },
      "ListItemInput": {
        "type": "object",
        "required": [
          "kind",
          "sourceId",
          "title"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "movie",
              "show"
            ]
          },
          "sourceId": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "posterPath": {
            "type": [
              "string",
              "null"
            ]
          },
          "isAnime": {
            "type": "boolean"
          }
        }
      },
      "CollectionItemInput": {
        "type": "object",
        "required": [
          "kind",
          "sourceId",
          "title",
          "format"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "movie",
              "show"
            ]
          },
          "sourceId": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string"
          },
          "format": {
            "type": "string",
            "enum": [
              "4k_bluray",
              "bluray",
              "hd_dvd",
              "dvd",
              "digital"
            ]
          },
          "season": {
            "type": "integer",
            "minimum": 0
          },
          "year": {
            "type": [
              "integer",
              "null"
            ]
          },
          "posterPath": {
            "type": [
              "string",
              "null"
            ]
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          },
          "isAnime": {
            "type": "boolean",
            "description": "Classifies the movie or show as anime without changing its routable kind."
          }
        }
      },
      "LogSeasonInput": {
        "type": "object",
        "required": [
          "episodes",
          "title",
          "year"
        ],
        "properties": {
          "episodes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SeasonEpisodeInput"
            }
          },
          "watchedAt": {
            "type": "string",
            "format": "date-time"
          },
          "dateUnknown": {
            "type": "boolean"
          },
          "title": {
            "type": "string"
          },
          "year": {
            "type": "integer"
          },
          "allowUnreleased": {
            "type": "boolean"
          },
          "allowRewatches": {
            "type": "boolean"
          }
        }
      },
      "SeasonEpisodeInput": {
        "type": "object",
        "required": [
          "episodeNumber",
          "name"
        ],
        "properties": {
          "episodeNumber": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string"
          },
          "runtime": {
            "type": "integer"
          },
          "communityRating": {
            "type": "number"
          },
          "airDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "watchedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "InteractionInput": {
        "type": "object",
        "properties": {
          "watchedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "rating": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 10
          },
          "isFavourite": {
            "type": "boolean"
          },
          "wantToWatch": {
            "type": "boolean"
          },
          "showStatus": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "WATCHED",
              "WATCHING",
              "PLANNING",
              "ON_HOLD",
              "DROPPED",
              null
            ]
          }
        },
        "minProperties": 1
      },
      "DeviceCodeInput": {
        "type": "object",
        "required": [
          "client_id"
        ],
        "properties": {
          "client_id": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          }
        }
      },
      "DeviceTokenInput": {
        "type": "object",
        "required": [
          "client_id",
          "device_code"
        ],
        "properties": {
          "client_id": {
            "type": "string"
          },
          "device_code": {
            "type": "string"
          },
          "device_id": {
            "type": "string"
          },
          "device_name": {
            "type": "string"
          }
        }
      },
      "RefreshTokenInput": {
        "type": "object",
        "required": [
          "client_id",
          "refresh_token"
        ],
        "properties": {
          "client_id": {
            "type": "string"
          },
          "refresh_token": {
            "type": "string"
          }
        }
      },
      "OAuthRevokeInput": {
        "type": "object",
        "required": [
          "client_id",
          "token"
        ],
        "properties": {
          "client_id": {
            "type": "string"
          },
          "client_secret": {
            "type": "string"
          },
          "token": {
            "type": "string"
          },
          "token_type_hint": {
            "type": "string",
            "enum": [
              "access_token",
              "refresh_token"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  }
}
